#!/usr/bin/env node
// 让「新窗口加载」发生在进度页背后：进度页保持在前，等 DSH 页面真正加载完成，
// 再把 DSH 窗口提到前面并关掉进度页。这样用户看不到加载期间的白屏/卡顿。
//
// 用法：dsh-browser-stage <debugPort> <progressPort> <targetUrl>
const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
const port = process.argv[2]
const progressPort = process.argv[3]
const targetUrl = process.argv[4]

let targetPort = ''
try {
  targetPort = new URL(targetUrl).port
} catch {
  process.exit(1)
}

const pages = async () => {
  try {
    const res = await fetch(`http://127.0.0.1:${port}/json/list`, { signal: AbortSignal.timeout(1200) })
    return (await res.json()).filter((t) => t.type === 'page')
  } catch {
    return []
  }
}
const activate = (id) => fetch(`http://127.0.0.1:${port}/json/activate/${id}`).catch(() => {})
const closeTarget = (id) => fetch(`http://127.0.0.1:${port}/json/close/${id}`).catch(() => {})

function readyState(id, ms = 1500) {
  return new Promise((resolve) => {
    let done = false
    const ws = new WebSocket(`ws://127.0.0.1:${port}/devtools/page/${id}`)
    const timer = setTimeout(() => {
      if (!done) { done = true; try { ws.close() } catch {}; resolve('') }
    }, ms)
    ws.onopen = () => ws.send(JSON.stringify({ id: 1, method: 'Runtime.evaluate', params: { expression: 'document.readyState', returnByValue: true } }))
    ws.onmessage = (e) => {
      const m = JSON.parse(e.data)
      if (m.id === 1) { done = true; clearTimeout(timer); try { ws.close() } catch {}; resolve(m.result?.result?.value ?? '') }
    }
    ws.onerror = () => { if (!done) { done = true; clearTimeout(timer); resolve('') } }
  })
}

const main = async () => {
  // 1) 把进度页顶到最前面，盖住刚开始加载的 DSH 窗口
  for (let i = 0; i < 20; i++) {
    const progress = (await pages()).find((p) => p.url.includes(':' + progressPort))
    if (progress) { await activate(progress.id); break }
    await sleep(150)
  }

  // 2) 等 DSH 页面加载完成（最多 60 秒）
  let dsh = null
  for (let i = 0; i < 120; i++) {
    const list = await pages()
    dsh = list.find((p) => p.url.includes(':' + targetPort)) || null
    if (dsh && (await readyState(dsh.id)) === 'complete') break
    await sleep(500)
  }
  if (!dsh) process.exit(1)

  // 3) 换到前面，再收掉进度页（只收还在显示进度页的那个 target）
  await activate(dsh.id)
  await sleep(700)
  const progress = (await pages()).find((p) => p.url.includes(':' + progressPort))
  if (progress) await closeTarget(progress.id)
  process.exit(0)
}

main()
