#!/bin/bash
# 用「专属窗口」打开 DSH Web：
#   1) 装了 Chromium 系浏览器 → 独立 profile + app 模式窗口；已经开着就把它提到前面，不新开
#   2) 只有 Safari → 用 AppleScript 维护一个专属窗口（首次会问一次“控制 Safari”的权限）
#   3) 都不行 → 退回默认浏览器打开一个标签页
#
# 用法：dsh-open <url>
DIR="$(cd "$(dirname "$0")" && pwd)"
URL="${1:-}"
[ -n "$URL" ] || exit 1

if [ "${DSH_OPEN_DRY_RUN:-0}" = 1 ]; then
  echo "would open: $URL"
  exit 0
fi

# 从 URL 里取出 host:port，用来在已开的窗口里找同一个服务
ORIGIN="$(printf '%s' "$URL" | sed -E 's#^[a-zA-Z]+://##; s#/.*$##')"
DEBUG_PORT="${DSH_WEB_BROWSER_DEBUG_PORT:-9333}"

# 通过 Chromium 的本地调试端口，把已经在显示同一个服务的窗口提到最前面
activate_existing() {
  node "$DIR/dsh-browser-focus" "$DEBUG_PORT" "$URL" "$ORIGIN" ${DSH_OPEN_MATCH:-} 2>/dev/null
}

# ---- 1) Chromium 系：独立 profile + app 窗口 ----
for app in "Chromium" "Google Chrome" "Microsoft Edge" "Brave Browser" "Arc" "Vivaldi"; do
  APP_PATH=""
  for base in /Applications "$HOME/Applications"; do
    [ -d "$base/$app.app" ] && APP_PATH="$base/$app.app" && break
  done
  [ -n "$APP_PATH" ] || continue

  # 已经开着（同一个 profile、调试端口在听）→ 只激活，不新开窗口
  if activate_existing; then
    exit 0
  fi

  PROFILE="${DSH_WEB_BROWSER_PROFILE:-$HOME/.dsh-web-launcher/browser-profile}"
  mkdir -p "$PROFILE" 2>/dev/null
  if open -na "$APP_PATH" --args --app="$URL" \
      --user-data-dir="$PROFILE" \
      --remote-debugging-port="$DEBUG_PORT" \
      --no-first-run --no-default-browser-check \
      --disable-features=Translate 2>/dev/null; then
    exit 0
  fi
done

# ---- 2) Safari：专属窗口（记住自己开的那个窗口 id） ----
if [ -d "/Applications/Safari.app" ] || [ -d "/System/Applications/Safari.app" ]; then
  ID_FILE="${DSH_WEB_SAFARI_ID:-$HOME/.dsh-web-launcher/safari-window.id}"
  mkdir -p "$(dirname "$ID_FILE")" 2>/dev/null
  if osascript "$DIR/open-in-safari.applescript" "$URL" "$ID_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# ---- 3) 兜底 ----
open "$URL"
